# Firebase Admin SDK for Push Notifications
# Get these from Firebase Console > Project Settings > Service Accounts > Generate Private Key
# Download the JSON file and extract these values:
FIREBASE_PROJECT_ID=unpuzzle-life
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@unpuzzle-life.iam.gserviceaccount.com
